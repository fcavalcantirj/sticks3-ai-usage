/* OPTIONAL — a DEVELOPER CONVENIENCE, not a runtime source (task 76).
 *
 * Credentials live in NVS on the device.  hal/sticks3/creds.cpp reads them
 * from NVS namespace "usaged" on every boot; the Wi-Fi portal writes them.
 * This header is used exactly once, by credsSeedFromSecretsIfEmpty(): when a
 * board's NVS record is not yet complete, the values below are copied into it
 * so a developer's own board works straight off a flash with no portal round
 * trip.  A complete NVS record is never overwritten by this header.
 *
 * THE PRODUCTION BUILD HAS NO secrets.h AND MUST COMPILE WITHOUT ONE — no
 * edits, no flags: creds.cpp gates the seed on __has_include("secrets.h").
 * That is the whole point.  These #defines are compile-time macros, so every
 * value below ends up as a plaintext string inside firmware.bin (verified with
 * `strings` against a real build).  A binary built WITH this file must never
 * be published to M5Burner or anywhere else — it would hand out the Wi-Fi
 * password of whoever built it.
 *
 * Copy to secrets.h (git-ignored — see firmware/include/secrets.h in .gitignore).
 * The device token is the LAN token from the repo .env — NEVER a provider key.
 *
 * OTA_PASS is THIS BOARD'S OWN password — never another board's.  It
 * authenticates ArduinoOTA uploads so only someone with the password can
 * flash this StickS3 unit #2 over Wi-Fi. */
#define WIFI_SSID "..."
#define WIFI_PASS "..."
#define USAGED_HOST "192.168.0.150"
#define USAGED_PORT 8765
#define USAGED_DEVICE_TOKEN "..."
// Set a unique OTA password — must match firmware/scripts/upload_ota.sh
#define OTA_PASS "set-a-unique-ota-password"
