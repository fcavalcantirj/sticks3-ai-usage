/* Copy to secrets.h (git-ignored — see firmware/include/secrets.h in .gitignore).
 * The device token is the LAN token from the repo .env — NEVER a provider key.
 *
 * OTA_PASS is THIS BOARD'S OWN password — never another board's.  It
 * authenticates ArduinoOTA uploads so only someone with the password can
 * flash this StickS3 unit #2 over Wi-Fi. */
#define WIFI_SSID "..."
#define WIFI_PASS "..."
#define USAGED_HOST "192.168.0.150"
#define USAGED_PORT 8765
#define USAGED_DEVICE_TOKEN "..."
// Set a unique OTA password — must match firmware/scripts/upload_ota.sh
#define OTA_PASS "set-a-unique-ota-password"
