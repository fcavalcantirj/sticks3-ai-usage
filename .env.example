# usaged configuration (copy to .env, the founder fills values)
# Usaged listens here; bind loopback when only the local browser is needed
#USAGED_LISTEN=0.0.0.0:8765
# Polling interval in seconds (must be >= 300 for Claude rate-limit hygiene)
#USAGED_INTERVAL_SEC=900
# Token for non-loopback (LAN) clients hitting /v1/* — replace with a real 32-char string
#USAGED_DEVICE_TOKEN=change-me-32-chars
# The device's own ArduinoOTA password, handed to it over BLE during zero-config
# setup so it can be reflashed without a cable. Unset leaves OTA DISARMED on the
# device — safe, but then the only way to update it is USB. Must match OTA_PASS
# in firmware/include/secrets.h for any device flashed from a dev build.
#USAGED_DEVICE_OTA_PASS=set-a-unique-ota-password
# State file path (supports $HOME expansion)
#USAGED_STATE=$HOME/.local/state/usaged/state.json
# Display timezone for reset-text rendering
#USAGED_TZ=America/Sao_Paulo
# OpenRouter API keys (main + fallback accounts)
#OPENROUTER_API_KEY=
#OPENROUTER_API_KEY_FALLBACK=
# Groq API key (key-valid check; set USAGED_GROQ_PROBE=1 for rate-limit headroom)
#GROQ_API_KEY=
#USAGED_GROQ_PROBE=0
# Codex: "http" (wham/usage, default) or "cli" (codex app-server JSON-RPC)
#USAGED_CODEX_SOURCE=http
# Claude: "auto" (statusline+oauth fallback, default), "oauth", or "statusline"
#USAGED_CLAUDE_SOURCE=auto
# Remote snapshot publish (task 59): PUT snapshot JSON to this URL on rev change,
# authenticated with the token below. Both empty = publishing disabled.
#USAGED_PUBLISH_URL=
#USAGED_PUBLISH_TOKEN=
# Log level: debug, info, warn, error
#USAGED_LOG_LEVEL=info
